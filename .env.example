# Copy to .env and fill in. Never commit the real file.
# Any secret can also be given as NAME_FILE=/path/to/file (Docker/systemd secrets).

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# ArvanCloud API key. Give it access to the CDN service only.
ARVAN_API_KEY=

# Numeric Telegram user IDs allowed to use the bot, comma separated.
# Get yours from @userinfobot. The bot refuses to start with an empty list.
ALLOWED_USER_IDS=

# Optional: only manage these zones (comma separated). Empty means all zones on the account.
ALLOWED_DOMAINS=

# Optional: true disables every change (DNS edits, cloud toggle, cache purge).
READ_ONLY=false

# Optional: fa or en
BOT_LANGUAGE=fa

# Optional: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Optional: reach Telegram through a proxy, e.g. socks5://127.0.0.1:1080
TELEGRAM_PROXY=

# Optional: override the API endpoint (must be https)
# ARVAN_BASE_URL=https://napi.arvancloud.ir
